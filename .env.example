# Exactly one reply provider is selected. Gemini is the default and uses Google ADC.
RESPONSE_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=your-google-cloud-project

# For OpenRouter, change RESPONSE_PROVIDER and provide only its selected credentials.
# RESPONSE_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-me
# OPENROUTER_MODEL=anthropic/claude-opus-5
